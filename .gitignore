# ==========================================
# DEPENDÊNCIAS E GERENCIADORES DE PACOTES
# ==========================================
**/node_modules/
**/.pnp
**/.pnp.*
**/.yarn/*
!**/.yarn/patches
!**/.yarn/plugins
!**/.yarn/releases
!**/.yarn/versions

# ==========================================
# BUILDS E SAÍDAS DE COMPILAÇÃO
# ==========================================
**/dist/
**/build/
**/.next/
**/out/
**/.out/
**/.nuxt/
**/.vercel/
*.tsbuildinfo
next-env.d.ts

# ==========================================
# VARIÁVEIS DE AMBIENTE E SEGURANÇA
# ==========================================
**/.env
**/.env.*
!**/.env.example
*.pem

# ==========================================
# ARCHIVOS GERADOS E PRISMA
# ==========================================
**/generated/prisma/

# ==========================================
# LOGS E DIAGNÓSTICOS
# ==========================================
logs
*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/.pnpm-debug.log*
**/lerna-debug.log*

# ==========================================
# TESTES E COBERTURA
# ==========================================
**/coverage/
**/.nyc_output/

# ==========================================
# ARQUIVOS TEMPORÁRIOS E RUNTIME
# ==========================================
**/.temp/
**/.tmp/
**/pids/
**/*.pid
**/*.seed
**/*.pid.lock
**/report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ==========================================
# SISTEMA OPERACIONAL E EDITORES/IDES
# ==========================================
.DS_Store
Thumbs.db
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json